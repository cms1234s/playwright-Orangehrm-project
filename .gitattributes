# Set line endings to LF for JavaScript/TypeScript files
* text=auto eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf


# Other text files
*.md text
*.json text
*.txt text

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary